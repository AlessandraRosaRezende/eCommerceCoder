<div class="product-form-container">
  <h1>Cadastrar Novo Produto</h1>
  <form action="/products/admin/addproduct" method="POST" class="product-form">
    <div class="form-group">
      <label for="title">Nome do Produto:</label>
      <input type="text" id="title" name="title" class="form-control" required>
    </div>

    <div class="form-group">
      <label for="description">Descrição:</label>
      <textarea id="description" name="description" class="form-control" rows="4"></textarea>
    </div>

    <div class="form-group">
      <label for="price">Preço:</label>
      <div class="input-group">
        <span class="input-group-text">$</span>
        <input type="number" id="price" name="price" step="0.01" class="form-control" required>
      </div>
    </div>

    <div class="form-group">
      <label for="code">Código do Produto:</label>
      <input type="text" id="code" name="code" class="form-control">
    </div>

    <div class="form-group">
      <label for="stock">Estoque:</label>
      <input type="number" id="stock" name="stock" class="form-control" value="0" required>
    </div>

    <div class="form-group">
      <label for="category">Categoria:</label>
      <input type="text" id="category" name="category" class="form-control">
    </div>

    <button type="submit" class="btn btn-primary">Cadastrar Produto</button>
    <a href="/products" class="btn btn-secondary">Voltar</a>
  </form>
</div>
