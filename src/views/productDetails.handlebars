<div class="product-details-container">
  <div class="product-header">
    <h1>{{product.name}}</h1>
    <p class="product-price">Preço: ${{formatPrice product.price}}</p>
  </div>

  <div class="product-info">
    <p class="product-description">{{product.description}}</p>
  </div>

  <div class="product-actions">
    <form action="/cart" method="post">
      <input type="hidden" name="productId" value="{{product._id}}">
      <div class="quantity-input-group">
        <label for="quantity">Quantidade:</label>
        <input type="number" id="quantity" name="quantity" min="1" value="1" required class="quantity-input">
      </div>
      <button type="submit" class="btn btn-success btn-add-to-cart">Adicionar ao Carrinho</button>
    </form>
    <a href="/products" class="btn btn-secondary">Voltar para Produtos</a>
  </div>
</div>