<div class="container">
  <h1>Gerenciar Usuários</h1>
  <table class="table">
    <thead>
      <tr>
        <th>Nome</th>
        <th>Email</th>
        <th>Tipo de Conta</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody>
      {{#each users}}
      <tr>
        <td>{{first_name}} {{last_name}}</td>
        <td>{{email}}</td>
        <td>{{role}}</td>
        <td>
          <a href="/admin/users/edit/{{_id}}" class="btn btn-sm btn-warning">Editar</a>
          <form action="/admin/users/{{_id}}?_method=DELETE" method="POST" style="display: inline;">
            <button type="submit" class="btn btn-sm btn-danger"
              onclick="return confirm('Tem certeza que deseja excluir este usuário?')">Excluir</button>
          </form>
        </td>
      </tr>
      {{else}}
      <tr>
        <td colspan="4">Nenhum usuário encontrado.</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>

